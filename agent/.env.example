# Copia come .env (non versionato)

# --- LLM (qualsiasi modello LiteLLM; default: Ollama Cloud) ---
LLM_MODEL=ollama_chat/gemma4:31b
# false = niente ragionamento nella risposta (consigliato per la voce: piu pulita e veloce)
LLM_THINK=false
LLM_API_BASE=https://ollama.com
LLM_API_KEY=
# Esempio Ollama locale:
#   LLM_MODEL=ollama_chat/llama3.2
#   LLM_API_BASE=http://host.docker.internal:11434
# Esempio gateway LiteLLM compatibile OpenAI:
#   LLM_MODEL=openai/<nome-modello>
#   LLM_API_BASE=https://<gateway>/v1

# --- Speech to text (faster-whisper, locale nel container) ---
# elevenlabs = Scribe (serve il permesso speech_to_text sulla chiave) | local = faster-whisper nel container (ripiego automatico)
STT_ENGINE=elevenlabs
# 1 = esegue anche l'altro motore e ne scrive il risultato nel log (solo confronto)
STT_COMPARE=0
STT_MODEL=small
STT_LANGUAGE=it
STT_COMPUTE_TYPE=int8

# --- Servizio ---
AGENT_TOKEN=
AGENT_LANGUAGE=italiano

# --- Text to speech ---
# kokoro = locale nel container (default) | elevenlabs; l'altro motore, se configurato, fa da ripiego
TTS_ENGINE=kokoro
KOKORO_VOICE=if_sara   # italiane: if_sara (donna), im_nicola (uomo)
KOKORO_SPEED=1.0       # 0.5-2.0
KOKORO_LANG=it
# ElevenLabs (opzionale: vuoto = solo Kokoro)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb   # Brian (premade, gratuita)
ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_LANGUAGE=it   # solo per modelli che supportano language_code (flash/turbo v2.5)

# --- Promemoria e notifiche (servizio notify/, token condiviso con l'agente e con le sorgenti eventi) ---
# Generare con: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOTIFY_TOKEN=

# --- Riconoscimento parlante (similarita minima 0-1: piu alta = piu severo; calibrare guardando i punteggi nel log) ---
SPEAKER_THRESHOLD=0.65

# Nomi propri da riconoscere meglio (suggerimento a Whisper)
# STT_PROMPT=Jarvis, Andrea, Marta.

# --- Memoria preferenze (Qdrant, embedding locali; QDRANT_URL e' impostato dal compose) ---
# MEMORY_TTL_DAYS=90                 # scadenza scorrevole, rinnovata a ogni uso
# MEMORY_CANDIDATE_TTL_DAYS=30       # i candidati mai ripetuti scadono prima
# MEMORY_PROMOTE_AFTER=2             # ripetizioni prima di usare una preferenza dedotta
# MEMORY_REPEAT_GAP_S=600            # ripetizioni piu' ravvicinate contano come una sola
# MEMORY_MIN_SCORE=0.30              # rilevanza minima per iniettare una memoria (da calibrare)
# MEMORY_SAME_SCORE=0.85             # similarita' per "stessa informazione" (da calibrare)
# PERSONALIZATION_THRESHOLD=0.75     # punteggio vocale minimo per usare le preferenze (> SPEAKER_THRESHOLD)
# PERSONALIZATION_MARGIN=0.05        # distacco minimo dal secondo candidato
# MEMORY_LLM_MODEL=                  # modello per l'estrazione (vuoto = LLM_MODEL)

# --- Debug skill ---
# SKILL_LOG_COMMANDS=1   # logga la riga di comando scritta dall'LLM (con i segnaposto, non i valori dei segreti)

# --- MQTT (notifiche alle schede; il broker e il servizio notify girano nel compose) ---
# Password dell utente "notify" del broker: creala con i comandi in knowledge/agent/notifications.md
MQTT_NOTIFY_PASSWORD=
# Schede che ricevono le notifiche "all" (separate da virgola, gli stessi id usati nel firmware)
NOTIFY_DEVICES=kitchen
# Token per sorgente di eventi (CI, HA): ci=<token>,ha=<token>. Generali come NOTIFY_TOKEN.
NOTIFY_SOURCE_TOKENS=
