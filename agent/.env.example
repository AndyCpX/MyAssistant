# Copia come .env (non versionato)

# --- LLM (qualsiasi modello LiteLLM; default: Ollama Cloud) ---
LLM_MODEL=ollama_chat/gemma4:31b
# false = niente ragionamento nella risposta (consigliato per la voce: piu pulita e veloce)
LLM_THINK=false
LLM_API_BASE=https://ollama.com
LLM_API_KEY=
# Esempio Ollama locale:
#   LLM_MODEL=ollama_chat/llama3.2
#   LLM_API_BASE=http://host.docker.internal:11434
# Esempio gateway LiteLLM compatibile OpenAI:
#   LLM_MODEL=openai/<nome-modello>
#   LLM_API_BASE=https://<gateway>/v1

# --- Speech to text (faster-whisper, locale nel container) ---
# elevenlabs = Scribe (serve il permesso speech_to_text sulla chiave) | local = faster-whisper nel container (ripiego automatico)
STT_ENGINE=elevenlabs
# 1 = esegue anche l'altro motore e ne scrive il risultato nel log (solo confronto)
STT_COMPARE=0
STT_MODEL=small
STT_LANGUAGE=it
STT_COMPUTE_TYPE=int8

# --- Servizio ---
AGENT_TOKEN=
AGENT_LANGUAGE=italiano

# --- Text to speech (ElevenLabs; vuoto = nessuna risposta vocale) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb   # Brian (premade, gratuita)
ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_LANGUAGE=it   # solo per modelli che supportano language_code (flash/turbo v2.5)

# --- Riconoscimento parlante (similarita minima 0-1: piu alta = piu severo; calibrare guardando i punteggi nel log) ---
SPEAKER_THRESHOLD=0.65

# Nomi propri da riconoscere meglio (suggerimento a Whisper)
# STT_PROMPT=Jarvis, Andrea, Marta.
